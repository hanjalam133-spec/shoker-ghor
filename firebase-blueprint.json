{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product for sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "images": { "type": "array" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "sizes": { "type": "array" },
        "inStock": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "price", "image", "description", "category", "inStock"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Products available in the shop"
    }
  }
}
